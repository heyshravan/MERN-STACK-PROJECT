# ExploreX Backend Environment Configuration Template

# Server Port
PORT=5000

# MongoDB Connection String
MONGO_URI=mongodb://127.0.0.1:27017/explorex

# JWT Secret Key for Session Authentication
JWT_SECRET=your_jwt_secret_key_here

# Google Gemini API Key for Live AI Tourist Assistant (optional for basic features)
GEMINI_API_KEY=your_gemini_api_key_here
